{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "CYPRESS_INSTALL_BINARY=0 npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://segsoft-icesi.westus3.cloudapp.azure.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
